        {"name": "Get All Images", "request": {"method": "GET", "header": [], "url": {"raw": "{{base_url}}/api/images", "host": ["{{base_url}}"], "path": ["api", "images"]}}},
        {"name": "Upload Image", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "multipart/form-data"}], "body": {"mode": "formdata", "formdata": [{"key": "file", "type": "file", "src": ""}, {"key": "altText", "type": "text", "value": "Sample image"}]}, "url": {"raw": "{{base_url}}/api/images/upload", "host": ["{{base_url}}"], "path": ["api", "images", "upload"]}}},
        {"name": "Update Image", "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"altText\": \"Updated alt text\"\n}"}, "url": {"raw": "{{base_url}}/api/images/:id", "host": ["{{base_url}}"], "path": ["api", "images", ":id"], "variable": [{"key": "id", "value": "1"}]}}},
        {"name": "Delete Image", "request": {"method": "DELETE", "header": [], "url": {"raw": "{{base_url}}/api/images/:id", "host": ["{{base_url}}"], "path": ["api", "images", ":id"], "variable": [{"key": "id", "value": "1"}]}}}
