    {
      "name": "Products",
      "item": [
        {"name": "Get All Products", "request": {"method": "GET", "header": [], "url": {"raw": "{{base_url}}/api/products", "host": ["{{base_url}}"], "path": ["api", "products"]}}},
        {"name": "Get Product By ID", "request": {"method": "GET", "header": [], "url": {"raw": "{{base_url}}/api/products/:id", "host": ["{{base_url}}"], "path": ["api", "products", ":id"], "variable": [{"key": "id", "value": "1"}]}}},
        {"name": "Create Product", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Sample Product\",\n  \"price\": 10.0,\n  \"category\": \"sample\"\n}"}, "url": {"raw": "{{base_url}}/api/products", "host": ["{{base_url}}"], "path": ["api", "products"]}}},
        {"name": "Update Product", "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Updated Product\",\n  \"price\": 20.0,\n  \"category\": \"updated\"\n}"}, "url": {"raw": "{{base_url}}/api/products/:id", "host": ["{{base_url}}"], "path": ["api", "products", ":id"], "variable": [{"key": "id", "value": "1"}]}}},
        {"name": "Update Product Image", "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"imageUrl\": \"/images/sample.jpg\"\n}"}, "url": {"raw": "{{base_url}}/api/products/:id/image", "host": ["{{base_url}}"], "path": ["api", "products", ":id", "image"], "variable": [{"key": "id", "value": "1"}]}}},
        {"name": "Delete Product", "request": {"method": "DELETE", "header": [], "url": {"raw": "{{base_url}}/api/products/:id", "host": ["{{base_url}}"], "path": ["api", "products", ":id"], "variable": [{"key": "id", "value": "1"}]}}}
      ]
    },
    {
