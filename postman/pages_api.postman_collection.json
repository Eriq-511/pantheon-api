    {
      "name": "Pages",
      "item": [
        {
          "name": "Get All Pages",
          "request": {"method": "GET", "header": [], "url": {"raw": "{{base_url}}/api/pages", "host": ["{{base_url}}"], "path": ["api", "pages"]}}
        },
        {
          "name": "Create Page",
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"title\": \"Sample Page\",\n  \"slug\": \"sample-page\",\n  \"content\": \"<p>This is a sample page.</p>\",\n  \"status\": \"published\"\n}"}, "url": {"raw": "{{base_url}}/api/pages", "host": ["{{base_url}}"], "path": ["api", "pages"]}}
        },
        {
          "name": "Get Page By Slug",
          "request": {"method": "GET", "header": [], "url": {"raw": "{{base_url}}/api/pages/:slug", "host": ["{{base_url}}"], "path": ["api", "pages", ":slug"], "variable": [{"key": "slug", "value": "sample-slug"}]}}
        },
        {
          "name": "Get Page By ID",
          "request": {"method": "GET", "header": [], "url": {"raw": "{{base_url}}/api/pages/id/:id", "host": ["{{base_url}}"], "path": ["api", "pages", "id", ":id"], "variable": [{"key": "id", "value": "1"}]}}
        },
        {
          "name": "Update Page",
          "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"title\": \"Updated Page\",\n  \"slug\": \"updated-page\",\n  \"content\": \"<p>Updated content.</p>\",\n  \"status\": \"published\"\n}"}, "url": {"raw": "{{base_url}}/api/pages/:id", "host": ["{{base_url}}"], "path": ["api", "pages", ":id"], "variable": [{"key": "id", "value": "1"}]}}
        },
        {
          "name": "Delete Page",
          "request": {"method": "DELETE", "header": [], "url": {"raw": "{{base_url}}/api/pages/:id", "host": ["{{base_url}}"], "path": ["api", "pages", ":id"], "variable": [{"key": "id", "value": "1"}]}}
        }
      ]
    },
    {
      "name": "Menu",
      "item": [
        {"name": "Get All Menu Items", "request": {"method": "GET", "header": [], "url": {"raw": "{{base_url}}/api/menu", "host": ["{{base_url}}"], "path": ["api", "menu"]}}},
        {"name": "Create Menu Item", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"title\": \"Sample Menu\",\n  \"url\": \"/sample\",\n  \"parentId\": null\n}"}, "url": {"raw": "{{base_url}}/api/menu", "host": ["{{base_url}}"], "path": ["api", "menu"]}}},
        {"name": "Reorder Menu Items", "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"order\": [1,2,3]\n}"}, "url": {"raw": "{{base_url}}/api/menu/reorder", "host": ["{{base_url}}"], "path": ["api", "menu", "reorder"]}}},
        {"name": "Update Menu Item", "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"title\": \"Updated Menu\",\n  \"url\": \"/updated\",\n  \"parentId\": null\n}"}, "url": {"raw": "{{base_url}}/api/menu/:id", "host": ["{{base_url}}"], "path": ["api", "menu", ":id"], "variable": [{"key": "id", "value": "1"}]}}},
        {"name": "Delete Menu Item", "request": {"method": "DELETE", "header": [], "url": {"raw": "{{base_url}}/api/menu/:id", "host": ["{{base_url}}"], "path": ["api", "menu", ":id"], "variable": [{"key": "id", "value": "1"}]}}}
      ]
